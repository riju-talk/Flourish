# Flourish API Environment Variables - copy to .env and fill in real values.
# See render.yaml for which of these must be set as secrets on the deployed host.

# CORS - comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Groq (LLM) - https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Tavily (live web search) - https://tavily.com
TAVILY_API_KEY=

# Unsplash (plant photos) - https://unsplash.com/developers
UNSPLASH_APPLICATION_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Perenual (deterministic plant-care database) - https://perenual.com/docs/api
PERENUAL_API_KEY=

# OpenWeather (optional - used for weather-aware care suggestions)
OPENWEATHER_API_KEY=

# Plant.id (optional - not currently wired into any active route)
PLANT_ID_API_KEY=

# Firebase Admin SDK - individual service-account fields from the downloaded JSON key
# (Project Settings > Service Accounts > Generate new private key). Keep
# FIREBASE_PRIVATE_KEY's literal \n sequences exactly as they appear in the JSON.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=

# Only needed if the project's "(default)" Firestore database isn't reachable via the
# classic Firestore API (e.g. provisioned as Enterprise edition with
# firestoreDataAccessMode disabled) - point this at a named Standard-edition database
# instead. Omit to use "(default)".
FIRESTORE_DATABASE_ID=(default)

# Used to sign anything the app itself signs (not Firebase auth, which is independent).
# Generate a random value for production - never reuse this example value.
SECRET_KEY=change-this-secret-key-in-production

# Bearer secret for /api/cron/* (see api/routes/cron.py). Only required on a
# serverless host (Vercel) where an external scheduler - not an in-process
# APScheduler - triggers the streak-risk/task-due/weekly-summary jobs. See
# docs/DEPLOYMENT.md. Generate a random value; leave blank on Render.
CRON_SECRET=
