# Firebase Trigger Email extension config - see docs/02-Tech-Stack-Architecture.md §5
# and the "Email (Firebase Trigger Email extension)" section of the deploy runbook.
#
# SMTP_PASSWORD (and any other secret-type param) is NOT set here - the Firebase CLI
# stores secret params in Secret Manager during `firebase ext:install`, never in this
# committed file.

MAIL_COLLECTION=mail
DEFAULT_FROM=Flourish <noreply@flourish-de908.firebaseapp.com>
DEFAULT_REPLY_TO=
TTL_EXPIRE_VALUE=1
TTL_EXPIRE_TYPE=day
LOCATION=us-central1
